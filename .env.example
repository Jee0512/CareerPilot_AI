# Rename this file to ".env" and fill in your key. Never commit the real .env file.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model. Default is "gemini-flash-latest", an
# alias that Google auto-updates to point at its current stable Flash model,
# so it won't go stale like a pinned version string (e.g. gemini-2.0-flash,
# which is being shut down June 1, 2026). Check the deprecations page before
# deploying if you pin an exact version: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-flash-latest
